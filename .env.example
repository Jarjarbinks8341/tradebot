# Copy to .env.local and fill in. Never commit the real values.

# --- Signal source ---
FIB_REPO=jiazhongchen/fib-accumulator
FIB_BRANCH=main
GITHUB_TOKEN=ghp_xxx_fine_grained_read_only_on_fib_accumulator

# --- IBKR connection (IB Gateway on this Mac) ---
# Paper: 4002, Live: 4001. TWS paper: 7497, TWS live: 7496.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=17

# --- Execution ---
# Safety: default dry-run. Flip to true only after paper validation.
EXECUTE=false
# Worst slippage tolerated between signal.reference_price and live quote.
MAX_REFERENCE_DRIFT_PCT=5.0
# Buying-power buffer multiplier on notional for BUY gate.
BUYING_POWER_BUFFER=1.02

# --- Paths ---
STATE_DB=state/executed_signals.db
RECEIPTS_DIR=receipts
HALT_FILE=HALT

# --- Live-trading hard limits (executor + MCP server share these) ---
# BUYs are always capped by settled cash (never margin), plus:
MAX_ORDER_USD=2500
# Rolling 24h total of BUY notional across executor + MCP.
MAX_DAILY_USD=5000
# Fat-finger guard for MCP orders: limit must be within this % of the quote.
MAX_LIMIT_FROM_QUOTE_PCT=3.0
# Separate clientId so the MCP server never collides with the hourly executor.
IB_MCP_CLIENT_ID=18

# --- Options (MCP only) ---
# Only cash-secured puts and long calls can be opened; naked calls / long puts are refused.
# Per-order cap on put assignment cash (strike x 100 x contracts). Defaults to MAX_ORDER_USD.
MAX_PUT_COLLATERAL_USD=2500
# Calls bought to open must have at least this many days to expiry (LEAPS-style).
MIN_LONG_CALL_DTE=180
# Fat-finger guard: option limit must be inside the bid/ask or within this % of the mid.
MAX_OPTION_LIMIT_FROM_MID_PCT=10.0
