<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  IB Gateway via IBC 3.23.0 (rebuilt 2026-10-02 for new account).
  Gateway: ~/Applications/IB Gateway 10.37   IBC: ~/ibc   Settings: ~/Jts
  Credentials live only in ~/ibc/config.ini (chmod 600).

  KeepAlive only on crash (SuccessfulExit=false). The old agent used
  KeepAlive=true: when Gateway was already up, gatewaystartmacos.sh printed
  "process is already running" and exited 0, so launchd relaunched it every
  60s forever. Daily restarts are handled inside IBC (AutoRestartTime).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jiazhongchen.ibgateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jiazhongchen/ibc/gatewaystartmacos.sh</string>
    <string>-inline</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jiazhongchen/ibc</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/jiazhongchen/Library/Logs/ibgateway.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jiazhongchen/Library/Logs/ibgateway.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
